# Payment Wallet — environment configuration
# Copy to `.env` and adjust. These map directly to Spring Boot properties via relaxed binding.

# --- PostgreSQL ---
# Each service connects to its own database on one Postgres instance:
#   user-service -> userdb, wallet-service -> walletdb, transaction-service -> transactiondb,
#   notification-service -> notificationdb, reward-service -> rewarddb
# SPRING_DATASOURCE_URL is set per-service (see docker-compose.yml / run-local.ps1);
# credentials are shared:
SPRING_DATASOURCE_USERNAME=payment
SPRING_DATASOURCE_PASSWORD=payment

# --- JWT (issued by user-service, validated by the gateway) ---
# Use a long, random secret (>= 32 bytes) in any real deployment.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# --- Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Inter-service URLs (gateway -> downstream; service -> service) ---
# Defaults target Docker service names; override to localhost for native/local runs.
USER_SERVICE_URL=http://localhost:8081
WALLET_SERVICE_URL=http://localhost:8088
TRANSACTION_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
REWARD_SERVICE_URL=http://localhost:8084

# --- Observability ---
# Distributed-tracing sample rate (1.0 = sample everything).
TRACING_SAMPLE_PROBABILITY=1.0
# Set to `ecs` (or `logstash`) for structured JSON console logs in containers;
# leave unset for human-readable logs when running locally.
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- CORS (api-gateway) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
